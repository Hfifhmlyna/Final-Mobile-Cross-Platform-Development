rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    function hasAnyRole(roles) {
      return isAuthenticated() && getUserData().role in roles;
    }
    function isAdmin() { return hasRole('ADMIN'); }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasAnyRole(['GURU_MAPEL', 'WALI_KELAS', 'GURU_BK', 'GURU_PIKET']));
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }
    match /assignments/{docId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['GURU_MAPEL', 'ADMIN']);
    }
    match /attendance/{docId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentId) || hasAnyRole(['GURU_MAPEL', 'GURU_PIKET', 'WALI_KELAS', 'ADMIN']));
      allow create: if hasAnyRole(['GURU_MAPEL', 'GURU_PIKET', 'ADMIN']);
      allow update: if hasAnyRole(['GURU_MAPEL', 'GURU_PIKET', 'ADMIN']);
      allow delete: if isAdmin();
    }
    match /violations/{docId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentId) || hasAnyRole(['WALI_KELAS', 'GURU_BK', 'GURU_PIKET', 'ADMIN']));
      allow create: if hasAnyRole(['WALI_KELAS', 'GURU_BK', 'GURU_PIKET', 'ADMIN']);
      allow update, delete: if hasAnyRole(['GURU_BK', 'ADMIN']);
    }
    match /counseling/{docId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentId) || hasAnyRole(['GURU_BK', 'ADMIN']));
      allow create: if isAuthenticated() && ((hasRole('SISWA') && request.resource.data.studentId == request.auth.uid) || hasAnyRole(['GURU_BK', 'ADMIN']));
      allow update: if hasAnyRole(['GURU_BK', 'ADMIN']);
      allow delete: if isAdmin();
    }
    match /chats/{chatId}/messages/{msgId} {
      allow read, write: if isAuthenticated();
    }
    match /notifications/{docId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }
    match /piket_logs/{docId} {
      allow read: if hasAnyRole(['GURU_PIKET', 'WALI_KELAS', 'ADMIN']);
      allow create: if hasAnyRole(['GURU_PIKET', 'ADMIN']);
      allow update, delete: if isAdmin();
    }
    match /emergency_broadcasts/{docId} {
      allow read: if isAuthenticated();
      allow create: if hasAnyRole(['GURU_PIKET', 'ADMIN']);
      allow delete: if isAdmin();
    }
    match /grades/{docId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentId) || hasAnyRole(['GURU_MAPEL', 'WALI_KELAS', 'ADMIN']));
      allow create, update: if hasAnyRole(['GURU_MAPEL', 'ADMIN']);
      allow delete: if isAdmin();
    }
    match /kelas/{kelasId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /quizzes/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasAnyRole(['GURU_MAPEL', 'ADMIN']);
    }
    match /quiz_submissions/{docId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentId) || hasAnyRole(['GURU_MAPEL', 'ADMIN']));
      allow create: if hasRole('SISWA') && request.resource.data.studentId == request.auth.uid;
      allow delete: if isAdmin();
    }

  }
}
